# Cloud Run injects PORT automatically. Use 8080 if setting it manually.
PORT=8080
# Local event time used for attendance schedules (Ecuador mainland).
APP_TIMEZONE_OFFSET=-05:00

# Cloud SQL MySQL connection or the public/private MySQL host.
DB_HOST=YOUR_MYSQL_HOST
DB_PORT=3306
DB_USER=YOUR_MYSQL_USER
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=flutter_login_db

# Generate a long random value. Never reuse the development value.
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET

ADMIN_EMAILS=admin@example.com

# Configure an SMTP provider for verification and invitation emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_EMAIL
SMTP_PASSWORD=YOUR_APP_PASSWORD
MAIL_FROM=YOUR_EMAIL
MAIL_PROVIDER=gmail_api
GMAIL_USER=YOUR_EMAIL
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
RESEND_API_KEY=
RESEND_FROM=

# Replace with the final HTTPS Cloud Run URL.
API_PUBLIC_URL=https://YOUR_CLOUD_RUN_SERVICE_URL

# Optional; defaults to 500 MB.
SECTION_MAX_FILE_SIZE=500
